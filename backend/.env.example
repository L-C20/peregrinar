# =====================================================
# ENTORNO
# =====================================================
NODE_ENV=development
PORT=3000

# URL publica de la aplicacion (para armar URLs absolutas de imagenes).
# Vacio = se usa la URL de la peticion. En produccion: https://tudominio.com
PUBLIC_URL=

# =====================================================
# BASE DE DATOS
# =====================================================
# En desarrollo, con el PostgreSQL del proyecto (npm run bd:iniciar):
DATABASE_URL=postgresql://postgres@localhost:5433/peregrinar_dev
# En produccion, la cadena que da Render, Railway o Supabase.
# true en Railway / Render / Supabase. false en Postgres local.
DATABASE_SSL=false

# =====================================================
# SEGURIDAD
# =====================================================
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Origenes permitidos por CORS, separados por coma.
# Vacio = mismo origen unicamente (recomendado en produccion).
CORS_ORIGINS=

# =====================================================
# MULTI-TENANT
# =====================================================
# Tenant que atiende la tienda publica cuando el dominio no esta registrado
# en la tabla tenant_dominios. Imprescindible mientras haya una sola tienda.
DEFAULT_TENANT_SLUG=editorial-peregrinar

# =====================================================
# ALMACENAMIENTO DE ARCHIVOS
# =====================================================
# local | cloudinary
#
# En produccion tiene que ser cloudinary: el disco de Render se borra
# en cada despliegue y las fotos subidas se pierden.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=5

# Solo con STORAGE_DRIVER=cloudinary. Los tres datos estan arriba de
# todo en el panel de cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================
# MERCADOPAGO (para pagos de suscripciones)
# =====================================================
# Obtener en: https://www.mercadopago.com.ar/developers/es/reference
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
