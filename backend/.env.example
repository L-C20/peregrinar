# =====================================================
# ENTORNO
# =====================================================
NODE_ENV=development
PORT=3000

# URL publica de la aplicacion (para armar URLs absolutas de imagenes).
# Vacio = se usa la URL de la peticion. En produccion: https://tudominio.com
PUBLIC_URL=

# =====================================================
# BASE DE DATOS
# =====================================================
# Ojo: el PostgreSQL de esta maquina escucha en el puerto 5000, no en el 5432.
DATABASE_URL=postgresql://usuario:password@localhost:5000/peregrinar_dev
# true en Railway / Render / Supabase. false en Postgres local.
DATABASE_SSL=false

# =====================================================
# SEGURIDAD
# =====================================================
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Origenes permitidos por CORS, separados por coma.
# Vacio = mismo origen unicamente (recomendado en produccion).
CORS_ORIGINS=

# =====================================================
# MULTI-TENANT
# =====================================================
# Tenant que atiende la tienda publica cuando el dominio no esta registrado
# en la tabla tenant_dominios. Imprescindible mientras haya una sola tienda.
DEFAULT_TENANT_SLUG=editorial-peregrinar

# =====================================================
# ALMACENAMIENTO DE ARCHIVOS
# =====================================================
# local | cloudinary  (cloudinary se implementa en la Etapa 12)
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=5
